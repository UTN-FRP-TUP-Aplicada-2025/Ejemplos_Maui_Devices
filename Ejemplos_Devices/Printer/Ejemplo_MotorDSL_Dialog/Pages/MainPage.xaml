<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:pageModels="clr-namespace:Ejemplo_MotorDSL_Dialog.ViewModels"
			 xmlns:controls="clr-namespace:Ejemplo_MotorDSL_Dialog.Controls"
             x:Class="Ejemplo_MotorDSL_Dialog.Pages.MainPage"
             x:DataType="pageModels:MainViewModel">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="30,0" Spacing="25">
                <HorizontalStackLayout>
                    <Button Text="Imprimir Prueba" Command="{Binding ImprimirEjemploCommand}" Margin="10"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:StatusOverlayView BindingContext="{Binding PrinterOverlayViewModel}"/>
    </Grid>

</ContentPage>
