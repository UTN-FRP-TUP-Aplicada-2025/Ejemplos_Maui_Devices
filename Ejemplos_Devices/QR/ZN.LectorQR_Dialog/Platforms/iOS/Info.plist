		<string>Assets.xcassets/appicon.appiconset</string>

		<key>MinimumOSVersion</key>
		<string>15.0</string>

		<key>CFBundleName</key>
		<string>Ejemplo_LectorQR_Dialog</string>

		<key>CFBundleDisplayName</key>
		<string>QR Lector</string>

		<key>CFBundleIdentifier</key>
		<string>com.ejemplos.devices.qr.dialog</string>

		<key>CFBundleVersion</key>
		<string>1.0</string>

		<key>CFBundleShortVersionString</key>
		<string>1.0</string>

		<key>LSRequiresIPhoneOS</key>
		<true/>

		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>

		<!-- Permiso REQUERIDO: la app usa la cámara en vivo (CameraView) para escanear QR/códigos -->
		<key>NSCameraUsageDescription</key>
		<string>Esta app necesita acceso a la cámara para escanear códigos QR.</string>
