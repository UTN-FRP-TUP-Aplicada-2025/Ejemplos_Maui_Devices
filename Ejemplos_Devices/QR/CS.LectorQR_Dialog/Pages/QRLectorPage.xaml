<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:CameraScanner.Maui;assembly=CameraScanner.Maui"
             x:Class="CS.LectorQR_Dialog.Pages.QRLectorPage"
             xmlns:local="clr-namespace:CS.LectorQR_Dialog.Pages"
             x:DataType="local:QRLectorPage"
             Title="QRLectorPage"
             BackgroundColor="#000000"
             NavigationPage.HasNavigationBar="False">

    <Grid x:Name="DynamicLayout" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*"
          HorizontalOptions="Fill" VerticalOptions="Fill">

        <Button x:Name="BtnFlashButton" Grid.Row="0" Grid.Column="0"
                Clicked="OnActiveFlashClicked" HorizontalOptions="Center" VerticalOptions="Center"
                Background="#aa000000" CornerRadius="8">
            <Button.ImageSource>
                <FontImageSource Glyph="{Binding FlashIcon}" FontFamily="MaterialIconsOutlined" />
            </Button.ImageSource>
        </Button>

        <cv:CameraView x:Name="Camera" Grid.Row="1" Grid.Column="0" OnDetectionFinished="OnCameraViewOnDetecte" HorizontalOptions="Fill" VerticalOptions="Fill" CameraEnabled="True" TorchOn="False" VibrationOnDetected="False" BarcodeFormats="QR,Code39"/>

        <Button x:Name="BtnVolver" Grid.Row="2" Grid.Column="0"
                 Clicked="OnVolverClicked" HorizontalOptions="Center" VerticalOptions="Center"
                 Background="#aa000000" CornerRadius="8">
            <Button.ImageSource>
                <FontImageSource Glyph="arrow_back" Size="50" FontFamily="MaterialIconsOutlined"/>
            </Button.ImageSource>
        </Button>

    </Grid>

</ContentPage>
